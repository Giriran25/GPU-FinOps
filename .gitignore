# ============================================================
# GPU-FinOps Git Ignore
# ============================================================

# Raw Alibaba GPU dataset
data/raw/

# Generated datasets
data/processed/

# Temporary/intermediate files
data/interim/*.db
data/interim/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment/secrets
.env
.env.*

# VS Code local files
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp